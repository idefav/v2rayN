<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSurface">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSidebar">#F6F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceBorder">#D0D7DE</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceText">#1F2328</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceMuted">#656D76</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSelection">#EAEEF2</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceActiveRow">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceActiveSelectedRow">#EAEEF2</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccent">#0969DA</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccentHover">#0550AE</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccentPressed">#033D8B</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSuccess">#1A7F37</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceWarning">#9A6700</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceDanger">#CF222E</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSuccessSurface">#DAFBE1</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkspaceBackground">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSurface">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSidebar">#161B22</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceBorder">#30363D</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceText">#E6EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceMuted">#A0A9B4</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSelection">#262C36</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceActiveRow">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceActiveSelectedRow">#262C36</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccent">#2F81F7</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccentHover">#388BFD</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceAccentPressed">#1F6FEB</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSuccess">#7EE787</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceWarning">#D29922</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceDanger">#FF7B72</SolidColorBrush>
                    <SolidColorBrush x:Key="WorkspaceSuccessSurface">#173322</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground">#0969DA</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground">#0550AE</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground">#033D8B</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDisabledBackground">#660969DA</SolidColorBrush>
            <x:Double x:Key="WorkspaceFontSize">14</x:Double>
            <x:Double x:Key="WorkspaceTitleSize">24</x:Double>
            <x:Double x:Key="WorkspaceSectionSize">16</x:Double>
            <x:Double x:Key="WorkspaceCaptionSize">12</x:Double>
            <x:Double x:Key="WorkspaceMetricSize">22</x:Double>
            <x:Double x:Key="WorkspaceRowHeight">53</x:Double>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WorkspaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceText}" />
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceFontSize}" />
    </Style>
    <Style Selector="Button, TextBox, ComboBox, ToggleSwitch, CheckBox, TabItem, ListBox, MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceFontSize}" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceFontSize}" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource WorkspaceAccentHover}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource WorkspaceAccentPressed}" />
    </Style>
    <Style Selector="Border.formGroup">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,8,0,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.settingsGroup">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSelection}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceSectionSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceCaptionSize}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceDanger}" />
    </Style>
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="FlyoutPresenter, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceText}" />
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource WorkspaceAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}" />
    </Style>
    <Style Selector="Button.rowAction">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceAccent}" />
    </Style>
    <Style Selector="Button.rowAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSelection}" />
    </Style>
    <Style Selector="Label.nodeStatus">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceFontSize}" />
    </Style>
    <Style Selector="Label.nodeStatus.activeStatus">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceSuccess}" />
        <Setter Property="Background" Value="{DynamicResource WorkspaceSuccessSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceDanger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceDanger}" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button.nav.selected">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSelection}" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.workspaceNavigation ListBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.workspaceNavigation ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="RowHeight" Value="{DynamicResource WorkspaceRowHeight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource WorkspaceBorder}" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSidebar}" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceCaptionSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="DataGridColumnHeader TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
    </Style>
    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSelection}" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSelection}" />
    </Style>
    <Style Selector="DataGridRow.activeServer">
        <Setter Property="Background" Value="{DynamicResource WorkspaceActiveRow}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="DataGridRow.activeServer:selected">
        <Setter Property="Background" Value="{DynamicResource WorkspaceActiveSelectedRow}" />
    </Style>
    <Style Selector="DataGridRow.activeServer /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource WorkspaceActiveRow}" />
    </Style>
    <Style Selector="DataGridRow.activeServer:selected /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource WorkspaceActiveSelectedRow}" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="TabControl.workspaceTabs /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Styles>
