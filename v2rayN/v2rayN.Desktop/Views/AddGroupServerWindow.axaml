<Window x:Class="v2rayN.Desktop.Views.AddGroupServerWindow"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib" xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:ws="clr-namespace:v2rayN.Desktop.Common"
    Title="{x:Static resx:ResUI.menuServers}" Width="960" Height="820" MinWidth="600" MinHeight="480"
    x:DataType="vms:AddGroupServerViewModel" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
            <Button x:Name="btnCancel" MinWidth="100" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" />
            <Button x:Name="btnSave" MinWidth="100" Content="{x:Static ws:WorkspaceText.Save}" IsDefault="True" Classes="primary" />
        </StackPanel>
        <Grid x:Name="basicFields" Classes="taskFields" DockPanel.Dock="Top" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,16">
            <TextBlock Text="{x:Static resx:ResUI.TbRemarks}" VerticalAlignment="Center" />
            <TextBox x:Name="txtRemarks" Grid.Column="1" Margin="0,0,0,12" />
            <TextBlock Grid.Row="1" Text="{x:Static resx:ResUI.TbCoreType}" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbCoreType" Grid.Row="1" Grid.Column="1" MinWidth="220" Margin="0,0,0,12" />
            <Grid x:Name="gridPolicyGroup" Classes="taskFields" Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="120,*">
                <TextBlock Text="{x:Static resx:ResUI.TbPolicyGroupType}" VerticalAlignment="Center" />
                <ComboBox x:Name="cmbPolicyGroupType" Grid.Column="1" MinWidth="220" />
            </Grid>
        </Grid>
        <TabControl x:Name="tabControl" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem x:Name="automaticTab" Header="{x:Static ws:WorkspaceText.Automatic}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
                    <Grid Classes="taskFields" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{x:Static resx:ResUI.menuSubscription}" VerticalAlignment="Center" />
                        <ComboBox x:Name="cmbSubChildItems" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,12" DisplayMemberBinding="{Binding Remarks}" ItemsSource="{Binding SubItems}" />
                        <TextBlock Grid.Row="1" Text="{x:Static resx:ResUI.LvFilter}" VerticalAlignment="Center" />
                        <ComboBox x:Name="cmbFilter" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12">
                        <TextBlock Text="{x:Static resx:ResUI.TbPolicyGroupSubChildTip}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock x:Name="txtMatchCount" Classes="sectionTitle" />
                    </StackPanel>
                    <DataGrid x:Name="lstAutomaticPreview" Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding AllProfilePreviewItemsObs}" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Binding="{Binding Remarks}" Header="{x:Static resx:ResUI.LvRemarks}" />
                            <DataGridTextColumn Width="*" Binding="{Binding ConfigType}" Header="{x:Static resx:ResUI.LvServiceType}" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Address}" Header="{x:Static resx:ResUI.LvAddress}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="manualTab" Header="{x:Static ws:WorkspaceText.Manual}">
                <DockPanel Margin="0,16,0,0" VerticalAlignment="Top">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="btnAddChild" Content="{x:Static resx:ResUI.menuAddChildServer}" Margin="0,0,8,8" />
                        <Button x:Name="btnRemoveChild" Content="{x:Static resx:ResUI.menuRemoveChildServer}" Margin="0,0,8,8" />
                        <Button x:Name="btnMoveUp" Content="{x:Static resx:ResUI.menuMoveUp}" Margin="0,0,8,8" />
                        <Button x:Name="btnMoveDown" Content="{x:Static resx:ResUI.menuMoveDown}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <Border x:Name="chainPreview" DockPanel.Dock="Bottom" Background="{DynamicResource WorkspaceSidebar}" CornerRadius="8" Margin="0,12,0,0" Padding="16" IsVisible="False">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Static ws:WorkspaceText.Preview}" Classes="sectionTitle" />
                            <TextBlock x:Name="txtChainOrder" TextWrapping="Wrap" Foreground="{DynamicResource WorkspaceAccent}" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="lstChild" Height="280" AutoGenerateColumns="False" CanUserSortColumns="False" HeadersVisibility="All" RowHeaderWidth="40" IsReadOnly="True" ItemsSource="{Binding ChildItemsObs}" SelectionMode="Extended">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuAddChildServer" Header="{x:Static resx:ResUI.menuAddChildServer}" />
                                <MenuItem x:Name="menuRemoveChildServer" Header="{x:Static resx:ResUI.menuRemoveChildServer}" InputGesture="Back" />
                                <MenuItem x:Name="menuSelectAllChild" Header="{x:Static resx:ResUI.menuSelectAll}" InputGesture="Ctrl+A" />
                                <Separator />
                                <MenuItem x:Name="menuMoveTop" Header="{x:Static resx:ResUI.menuMoveTop}" />
                                <MenuItem x:Name="menuMoveUp" Header="{x:Static resx:ResUI.menuMoveUp}" />
                                <MenuItem x:Name="menuMoveDown" Header="{x:Static resx:ResUI.menuMoveDown}" />
                                <MenuItem x:Name="menuMoveBottom" Header="{x:Static resx:ResUI.menuMoveBottom}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Binding="{Binding Remarks}" Header="{x:Static resx:ResUI.LvRemarks}" />
                            <DataGridTextColumn Width="*" Binding="{Binding ConfigType}" Header="{x:Static resx:ResUI.LvServiceType}" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Address}" Header="{x:Static resx:ResUI.LvAddress}" />
                            <DataGridTextColumn Width="90" Binding="{Binding Port}" Header="{x:Static resx:ResUI.LvPort}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{x:Static ws:WorkspaceText.Preview}">
                <DataGrid x:Name="lstPreviewChild" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" ItemsSource="{Binding AllProfilePreviewItemsObs}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*" Binding="{Binding Remarks}" Header="{x:Static resx:ResUI.LvRemarks}" />
                        <DataGridTextColumn Width="*" Binding="{Binding ConfigType}" Header="{x:Static resx:ResUI.LvServiceType}" />
                        <DataGridTextColumn Width="2*" Binding="{Binding Address}" Header="{x:Static resx:ResUI.LvAddress}" />
                        <DataGridTextColumn Width="90" Binding="{Binding Port}" Header="{x:Static resx:ResUI.LvPort}" />
                        <DataGridTextColumn Width="*" Binding="{Binding Network}" Header="{x:Static resx:ResUI.LvTransportProtocol}" />
                        <DataGridTextColumn Width="*" Binding="{Binding StreamSecurity}" Header="{x:Static resx:ResUI.LvTLS}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
