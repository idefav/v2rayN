<UserControl x:Class="v2rayN.Desktop.Views.ClashProxiesView" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib" xmlns:conv="using:v2rayN.Desktop.Converters" xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib" x:DataType="vms:ClashProxiesViewModel">
 <UserControl.Resources><conv:UnknownTextConverter x:Key="UnknownTextConverter"/><conv:ActiveStatusConverter x:Key="ActiveStatusConverter"/></UserControl.Resources>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
  <StackPanel Spacing="12">
   <TextBlock x:Name="txtProxyState" TextWrapping="Wrap" Classes="muted" />
   <Border x:Name="singleNode" Background="{DynamicResource WorkspaceSurface}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="10" Padding="20" MaxWidth="780" HorizontalAlignment="Stretch">
   <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,16,Auto,16,Auto,16,Auto">
    <TextBlock x:Name="labelNode" Classes="muted" VerticalAlignment="Center" />
    <TextBlock x:Name="txtNodeName" Grid.Column="2" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="labelProtocol" Grid.Row="2" Classes="muted" />
    <TextBlock x:Name="txtNodeProtocol" Grid.Row="2" Grid.Column="2" />
    <TextBlock x:Name="labelExit" Grid.Row="4" Classes="muted" />
    <ContentControl x:Name="exitLocation" Grid.Row="4" Grid.Column="2" />
    <TextBlock x:Name="txtExitInfo" Grid.Row="6" Grid.ColumnSpan="3" TextWrapping="Wrap" Classes="muted" />
   </Grid></Border>
   <WrapPanel>
    <Button x:Name="btnChangeNode" Margin="0,0,8,8" />
    <Button x:Name="btnEditNode" Margin="0,0,8,8" />
    <Button x:Name="btnCheckExit" Margin="0,0,8,8" />
   </WrapPanel>
  </StackPanel>
  <WrapPanel>
   <TextBlock Text="{x:Static resx:ResUI.menuRulemode}" VerticalAlignment="Center" Margin="0,0,8,8"/>
   <ComboBox x:Name="cmbRulemode" Width="120" Margin="0,0,16,8" PlaceholderText="—"/>
   <TextBlock x:Name="sortingLabel" Text="{x:Static resx:ResUI.TbSorting}" VerticalAlignment="Center" Margin="0,0,8,8"/>
   <ComboBox x:Name="cmbSorting" Width="120" Margin="0,0,16,8">
    <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingDelay}"/><ComboBoxItem Content="{x:Static resx:ResUI.TbSortingName}"/><ComboBoxItem Content="{x:Static resx:ResUI.TbSortingDefault}"/>
   </ComboBox>
   <Button x:Name="menuProxiesReload" Content="{x:Static resx:ResUI.menuProxiesReload}" Margin="0,0,8,8"/>
   <Button x:Name="menuGroupProxiesDelaytest" Content="{x:Static resx:ResUI.menuDelaytest}" Margin="0,0,16,8"/>
   <ToggleSwitch x:Name="togAutoRefresh" Content="{x:Static resx:ResUI.TbAutoRefresh}" Margin="0,0,0,8"/>
  </WrapPanel>
  <TextBlock x:Name="txtModeHelp" TextWrapping="Wrap" Classes="muted" />
  <Grid x:Name="proxyWorkspace" ColumnDefinitions="240,16,*" Height="360">
   <ListBox x:Name="lstProxyGroups" ItemsSource="{Binding ProxyGroups}" BorderThickness="1" BorderBrush="{DynamicResource WorkspaceBorder}">
    <ListBox.ItemTemplate><DataTemplate>
     <StackPanel Spacing="4" Margin="12">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Type}" Classes="muted"/><TextBlock Text="{Binding Now}" Classes="muted" TextWrapping="Wrap"/>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <DockPanel Grid.Column="2">
    <DockPanel DockPanel.Dock="Top" Margin="16,0,0,16">
     <Button x:Name="btnActivateProxy" DockPanel.Dock="Right" Content="{x:Static resx:ResUI.menuProxiesSelectActivity}" Classes="primary"/>
     <StackPanel Spacing="6">
     <TextBlock Text="{Binding SelectedGroup.Name}" Classes="sectionTitle"/>
     <TextBlock x:Name="txtStrategy" Classes="muted" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding SelectedGroup.Now}" TextWrapping="Wrap"/>
     </StackPanel>
    </DockPanel>
    <DataGrid x:Name="lstProxyDetails" ItemsSource="{Binding ProxyDetails}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
     <DataGrid.ContextMenu><ContextMenu>
      <MenuItem x:Name="menuProxyDelaytest" Header="{x:Static resx:ResUI.menuDelaytest}"/>
      <MenuItem x:Name="menuProxiesSelectActivity" Header="{x:Static resx:ResUI.menuProxiesSelectActivity}" InputGesture="Enter"/>
     </ContextMenu></DataGrid.ContextMenu>
     <DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding IsActive, Mode=OneWay, Converter={StaticResource ActiveStatusConverter}}" Width="80" />
      <DataGridTextColumn Header="{x:Static resx:ResUI.LvRemarks}" Binding="{Binding Name}" Width="2*" MinWidth="140"/>
      <DataGridTextColumn Header="{x:Static resx:ResUI.LvServiceType}" Binding="{Binding Type}" Width="*" MinWidth="80"/>
      <DataGridTextColumn Header="{x:Static resx:ResUI.LvTestDelay}" Binding="{Binding DelayName, Mode=OneWay, Converter={StaticResource UnknownTextConverter}, ConverterParameter=test}" Width="*" MinWidth="100"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Grid>
  <Expander x:Name="technicalInfo"><TextBlock x:Name="txtTechnical" TextWrapping="Wrap" Margin="12" /></Expander>
  <Expander x:Name="configurationHelp"><TextBlock x:Name="txtConfigurationHelp" TextWrapping="Wrap" Margin="12" /></Expander>
 </StackPanel></ScrollViewer>
</UserControl>
