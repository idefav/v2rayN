<Window x:Class="v2rayN.Desktop.Views.AddSshServerWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib" xmlns:ws="clr-namespace:v2rayN.Desktop.Common"
 xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib" x:DataType="vms:AddSshServerViewModel" Title="{x:Static resx:SshStrings.Title}"
 Width="720" Height="820" MinWidth="600" MinHeight="480" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Spacing="8">
   <Border BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
    <StackPanel Spacing="6">
     <TextBlock Text="{x:Static resx:SshStrings.TestConnection}" Classes="muted"/>
     <TextBlock x:Name="txtTestStatus" TextWrapping="Wrap"/>
     <TextBlock x:Name="txtLoginResult" TextWrapping="Wrap"/>
     <TextBlock x:Name="txtProxyResult" TextWrapping="Wrap"/>
     <ProgressBar IsVisible="{Binding IsTesting}" IsIndeterminate="True" Height="3"/>
    </StackPanel>
   </Border>
   <WrapPanel HorizontalAlignment="Right">
    <Button x:Name="btnTest" Content="{x:Static resx:SshStrings.TestConnection}" Margin="4"/>
    <Button x:Name="btnStopTest" Content="{x:Static resx:SshStrings.StopTest}" Margin="4" IsVisible="False"/>
    <Button x:Name="btnCancel" Content="{x:Static resx:ResUI.TbCancel}" MinWidth="90" Margin="4"/>
    <Button x:Name="btnSave" Classes="primary" Content="{x:Static resx:ResUI.TbConfirm}" MinWidth="110" Margin="4"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="form" Spacing="12">
    <Border Classes="formGroup">
     <StackPanel Spacing="8">
      <TextBlock Classes="sectionTitle" Text="{x:Static ws:WorkspaceText.Basic}"/>
      <Grid x:Name="basicFields" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" Classes="taskFields">
       <TextBlock Text="{x:Static resx:ResUI.TbRemarks}" VerticalAlignment="Center"/><TextBox x:Name="txtRemarks" Grid.Column="1" Margin="0,0,0,8"/>
       <TextBlock Text="{x:Static resx:ResUI.TbAddress}" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="txtAddress" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
       <TextBlock Text="{x:Static resx:ResUI.TbPort}" Grid.Row="2" VerticalAlignment="Center"/><TextBox x:Name="txtPort" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"/>
       <TextBlock Text="{x:Static resx:ResUI.TbUsername}" Grid.Row="3" VerticalAlignment="Center"/><TextBox x:Name="txtUsername" Grid.Row="3" Grid.Column="1"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border Classes="formGroup">
     <StackPanel Spacing="8">
      <TextBlock Classes="sectionTitle" Text="{x:Static ws:WorkspaceText.Authentication}"/>
      <CheckBox x:Name="chkPrivateKey" Content="{x:Static resx:SshStrings.PrivateKeyAuth}"/>
      <StackPanel x:Name="passwordPanel" Spacing="6">
       <TextBlock Text="{x:Static resx:SshStrings.LoginPassword}"/><TextBox x:Name="txtPassword" PasswordChar="●"/>
      </StackPanel>
      <StackPanel x:Name="keyPanel" Spacing="6">
       <TextBlock Text="{x:Static resx:SshStrings.PrivateKeyPath}"/>
       <DockPanel><Button x:Name="btnBrowse" DockPanel.Dock="Right" Content="{x:Static resx:ResUI.TbBrowse}" Margin="8,0,0,0"/><TextBox x:Name="txtPrivateKeyPath"/></DockPanel>
       <TextBlock Text="{x:Static resx:SshStrings.Passphrase}"/><TextBox x:Name="txtPassphrase" PasswordChar="●"/>
       <Button x:Name="btnSetupKey" Content="{x:Static resx:SshStrings.SetupKey}" HorizontalAlignment="Left"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Classes="formGroup">
     <StackPanel Spacing="8">
      <TextBlock Classes="sectionTitle" Text="{x:Static resx:SshStrings.HostKey}"/>
      <TextBlock x:Name="txtStatus" Classes="muted" TextWrapping="Wrap"/>
      <TextBox x:Name="txtHostKey" TextWrapping="Wrap" MinHeight="60" AcceptsReturn="True"/>
      <WrapPanel>
       <Button x:Name="btnFetch" Content="{x:Static resx:SshStrings.Fetch}" Margin="0,0,8,4"/>
       <Button x:Name="btnTrust" Content="{x:Static resx:SshStrings.Trust}" Margin="0,0,0,4"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Expander Header="{x:Static ws:WorkspaceText.Advanced}" HorizontalAlignment="Stretch">
     <StackPanel Spacing="8">
      <CheckBox x:Name="chkUdpForwarding" Content="{x:Static resx:SshStrings.UdpForwarding}" />
      <CheckBox x:Name="chkAllowHttp3" Content="{x:Static resx:SshStrings.AllowHttp3}" IsEnabled="{Binding UdpForwarding}" />
      <TextBlock Classes="muted" Text="{x:Static resx:SshStrings.UdpNotice}" TextWrapping="Wrap"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
