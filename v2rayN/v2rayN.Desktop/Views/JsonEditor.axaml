<UserControl
    x:Class="v2rayN.Desktop.Views.JsonEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,12">
            <Button x:Name="btnFormat" DockPanel.Dock="Right" Click="FormatJson_Click" Content="{x:Static resx:ResUI.menuEditFormat}" />
            <TextBlock x:Name="txtValidation" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
        </DockPanel>
        <Border Classes="surface" Padding="8">
    <ae:TextEditor
        Name="Editor"
        FontFamily="Cascadia Code,Consolas,Monospace"
        FontSize="{DynamicResource WorkspaceFontSize}"
        ShowLineNumbers="True">
        <ae:TextEditor.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="menuFormat" Click="FormatJson_Click" Header="{x:Static resx:ResUI.menuEditFormat}" />
                <Separator />
                <MenuItem Click="Copy_Click" Header="{x:Static resx:ResUI.menuEditCopy}" />
                <MenuItem x:Name="menuPaste" Click="Paste_Click" Header="{x:Static resx:ResUI.menuEditPaste}" />
                <MenuItem Click="SelectAll_Click" Header="{x:Static resx:ResUI.menuEditSelectAll}" />
            </ContextMenu>
        </ae:TextEditor.ContextMenu>
    </ae:TextEditor>
        </Border>
    </DockPanel>
</UserControl>
