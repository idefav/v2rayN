<Window x:Class="v2rayN.Desktop.Views.AddServer2Window" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib" xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
 xmlns:ws="clr-namespace:v2rayN.Desktop.Common" x:DataType="vms:AddServer2ViewModel"
 Title="{x:Static resx:ResUI.menuAddCustomServer}" Width="900" Height="820" MinWidth="600" MinHeight="480" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
   <Button x:Name="btnCancel" MinWidth="100" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True"/>
   <Button x:Name="btnSave" MinWidth="110" Classes="primary" Content="{x:Static ws:WorkspaceText.Save}" IsDefault="True"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="configurationBody" Spacing="12">
    <Border Classes="formGroup">
     <StackPanel Spacing="12">
      <TextBlock Classes="sectionTitle" Text="{x:Static ws:WorkspaceText.Basic}"/>
      <Grid Classes="responsiveCards">
       <StackPanel Spacing="6">
        <TextBlock Text="{x:Static resx:ResUI.TbRemarks}"/><TextBox x:Name="txtRemarks"/>
       </StackPanel>
       <StackPanel Spacing="6">
        <TextBlock Text="{x:Static ws:WorkspaceText.ConfigurationFile}"/>
        <DockPanel>
         <Button x:Name="btnEdit" DockPanel.Dock="Right" Content="{x:Static resx:ResUI.TbEdit}" Margin="8,0,0,0"/>
         <Button x:Name="btnBrowse" DockPanel.Dock="Right" Content="{x:Static resx:ResUI.TbBrowse}" Margin="8,0,0,0"/>
         <TextBox x:Name="txtAddress" IsReadOnly="True"/>
        </DockPanel>
       </StackPanel>
      </Grid>
      <Grid Classes="taskFields" ColumnDefinitions="120,*">
       <TextBlock Text="{x:Static resx:ResUI.TbCoreType}" VerticalAlignment="Center"/>
       <ComboBox x:Name="cmbCoreType" Grid.Column="1" MinWidth="220" PlaceholderText="{x:Static ws:WorkspaceText.Automatic}"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border x:Name="gridCustomServer" Classes="formGroup">
     <StackPanel Spacing="8">
      <Grid Classes="responsiveCards">
       <StackPanel Spacing="6">
        <ToggleSwitch x:Name="togDisplayLog" Content="{x:Static resx:ResUI.TbDisplayLog}"/>
        <TextBlock Text="{x:Static resx:ResUI.TipDisplayLog}" Classes="muted" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Spacing="6">
        <TextBlock Text="{x:Static resx:ResUI.TbPreSocksPort}"/><TextBox x:Name="txtPreSocksPort"/>
       </StackPanel>
      </Grid>
      <Expander Header="{x:Static ws:WorkspaceText.Advanced}" HorizontalAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBlock Text="{x:Static resx:ResUI.TipPreSocksPort}" TextWrapping="Wrap" Classes="muted"/>
        <TextBlock Text="{x:Static resx:ResUI.CustomServerTips}" TextWrapping="Wrap" Classes="muted"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Border>
    <Border x:Name="gridCustomOutbound" Classes="formGroup" IsVisible="False">
     <StackPanel Spacing="8">
      <ToggleSwitch x:Name="togSingBoxEndpoint" Content="sing-box Endpoint"/>
      <TextBlock Text="{x:Static resx:ResUI.TbCustomOutboundTip}" TextWrapping="Wrap" Classes="muted"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
