<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
             xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
             x:Class="v2rayN.Desktop.Views.ProxyCheckView" x:DataType="vm:ProxyCheckViewModel">
    <UserControl.Styles>
        <Style Selector="Border.check-result"><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" /></Style>
        <Style Selector="Border.check-result.failed"><Setter Property="BorderBrush" Value="#D85A5A" /></Style>
        <Style Selector="Border.check-result.passed"><Setter Property="BorderBrush" Value="#308864" /></Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="0,0,12,24">
            <Border Background="{DynamicResource WorkspaceSidebar}" CornerRadius="12" Padding="18">
                <SelectableTextBlock Text="{Binding EnvironmentText}" TextWrapping="Wrap" />
            </Border>
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="start" Classes="primary" Margin="0,0,8,8" IsEnabled="{Binding CanStart}" />
                <Button x:Name="cancel" Margin="0,0,8,8" IsEnabled="{Binding IsRunning}" />
                <Button x:Name="retry" Margin="0,0,8,8" IsEnabled="{Binding CanRetry}" />
                <Button x:Name="saveBaseline" Margin="0,0,8,8" IsEnabled="{Binding CanExport}" />
                <Button x:Name="loadBaseline" Margin="0,0,8,8" IsEnabled="{Binding CanStart}" />
                <Button x:Name="export" Margin="0,0,8,8" IsEnabled="{Binding CanExport}" />
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Height="3" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BaselineText}" TextWrapping="Wrap" Opacity="0.7" />
            <Expander x:Name="observerSection" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" IsEnabled="{Binding CanStart}" Margin="0,12,0,0">
                    <CheckBox x:Name="enableObserver" IsChecked="{Binding UseObserver}" />
                    <WrapPanel>
                        <Button x:Name="importObserver" Margin="0,0,8,8" />
                        <Button x:Name="testObserver" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBox Text="{Binding ObserverProfileJson}" AcceptsReturn="True" MinHeight="100" MaxHeight="220" PlaceholderText="profile.json" />
                    <TextBlock x:Name="observerCredentialLabel" TextWrapping="Wrap" />
                    <TextBox x:Name="observerCredentialInput" Text="{Binding ObserverCredential}" PasswordChar="●" />
                    <SelectableTextBlock Text="{Binding ObserverStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
            <Expander x:Name="advanced" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" IsEnabled="{Binding CanStart}" Margin="0,12,0,0">
                    <TextBlock x:Name="expectedLabel" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ExpectedEgress}" PlaceholderText="203.0.113.10, 2001:db8::/32" />
                    <TextBlock x:Name="rulesLabel" TextWrapping="Wrap" />
                    <TextBox Text="{Binding TargetRules}" AcceptsReturn="True" MinHeight="70" PlaceholderText="www.cloudflare.com=203.0.113.0/24" />
                    <TextBlock Text="HTTPS / HTTP3" />
                    <TextBox Text="{Binding HttpsUrl}" />
                    <TextBlock Text="HTTP" />
                    <TextBox Text="{Binding HttpUrl}" />
                    <TextBlock Text="STUN (host:port)" />
                    <TextBox Text="{Binding StunTarget}" />
                    <TextBlock x:Name="dnsLabel" />
                    <TextBox Text="{Binding DnsTarget}" />
                    <TextBlock x:Name="localDnsLabel" TextWrapping="Wrap" />
                    <TextBox Text="{Binding LocalDnsTarget}" PlaceholderText="127.0.0.1:1053" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0"><TextBlock x:Name="samplesLabel" /><TextBox Text="{Binding Samples}" Width="90" /></StackPanel>
                        <StackPanel Margin="0,0,16,0"><TextBlock x:Name="timeoutLabel" /><TextBox Text="{Binding Timeout}" Width="90" /></StackPanel>
                        <StackPanel><TextBlock x:Name="h3TimeoutLabel" /><TextBox Text="{Binding Http3Timeout}" Width="90" /></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:ProxyDiagnosticResult">
                        <Border Classes="check-result" Classes.failed="{Binding IsFailed}" Classes.passed="{Binding IsPassed}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusLabel}" />
                                <SelectableTextBlock Text="{Binding ExitLabel}" TextWrapping="Wrap" />
                                <Expander Header="{Binding Target}" HorizontalAlignment="Stretch">
                                    <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="limits" TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
