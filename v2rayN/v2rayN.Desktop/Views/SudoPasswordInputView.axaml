<UserControl x:Class="v2rayN.Desktop.Views.SudoPasswordInputView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib">
    <DockPanel Margin="24" MinWidth="320" MaxWidth="480">
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0" DockPanel.Dock="Bottom">
            <Button x:Name="btnCancel" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" MinWidth="90" Margin="0,0,12,0" />
            <Button x:Name="btnSave" Classes="primary" Content="{x:Static resx:ResUI.TbConfirm}" IsDefault="True" MinWidth="90" />
        </WrapPanel>
        <ScrollViewer>
            <StackPanel Spacing="16">
                <Path Width="24" Height="24" Stroke="{DynamicResource WorkspaceAccent}" StrokeThickness="1.5" Stretch="Uniform" Data="M6,10 L18,10 18,21 6,21 Z M8,10 L8,7 C8,2 16,2 16,7 L16,10 M12,14 L12,17" HorizontalAlignment="Left" />
                <TextBlock Classes="sectionTitle" Text="{x:Static resx:ResUI.TbSettingsLinuxSudoPassword}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{x:Static resx:ResUI.TbSettingsLinuxSudoPasswordTip}" TextWrapping="Wrap" />
                <TextBox x:Name="txtPassword" PasswordChar="●" Classes="revealPasswordButton" Focusable="True" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
