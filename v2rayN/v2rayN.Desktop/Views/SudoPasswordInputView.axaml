<UserControl x:Class="v2rayN.Desktop.Views.SudoPasswordInputView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Width="420" Background="{DynamicResource WorkspaceSurface}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WorkspaceBorder}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" MinWidth="84" MinHeight="44" Margin="0,0,8,0" />
                <Button x:Name="btnSave" Classes="primary" IsDefault="True" MinWidth="84" MinHeight="44" />
            </WrapPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="24">
                <ContentControl x:Name="authorizationIcon" Width="28" Height="28" HorizontalAlignment="Left" />
                <TextBlock x:Name="txtAuthorizationTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="txtAuthorizationPurpose" TextWrapping="Wrap" />
                <TextBlock x:Name="txtAuthorizationPrivacy" Classes="caption muted" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static resx:ResUI.TbSettingsLinuxSudoPassword}" TextWrapping="Wrap" />
                <TextBox x:Name="txtPassword" PasswordChar="●" Classes="revealPasswordButton" Focusable="True" MinHeight="44" />
                <TextBlock x:Name="txtAuthorizationError" Classes="error" IsVisible="False" TextWrapping="Wrap" />
                <TextBlock x:Name="txtAuthorizationStatus" Classes="muted caption" IsVisible="False" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
