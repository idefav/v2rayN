<UserControl x:Class="v2rayN.Desktop.Views.BackupAndRestoreView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib" Tag="{x:Static resx:ResUI.menuBackupAndRestore}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="12">
            <TextBlock Name="txtMsg" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="btnSave" Classes="primary" Content="{x:Static resx:ResUI.TbConfirm}" MinWidth="100" Margin="0,0,8,0" />
                <Button x:Name="btnCancel" Content="{x:Static resx:ResUI.TbCancel}" MinWidth="100" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">
                <Border Classes="surface">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="sectionTitle" Text="{x:Static resx:ResUI.menuLocalBackupAndRestore}" />
                        <TextBlock x:Name="txtLocalHelp" Classes="muted" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Name="menuLocalBackup" Classes="primary" Content="{x:Static resx:ResUI.menuLocalBackup}" Margin="0,0,12,8" />
                            <Button Name="menuLocalRestore" Content="{x:Static resx:ResUI.menuLocalRestore}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Classes="surface">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="sectionTitle" Text="{x:Static resx:ResUI.menuRemoteBackupAndRestore}" />
                        <TextBlock x:Name="txtRemoteHelp" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static resx:ResUI.LvWebDavUrl}" /><TextBox x:Name="txtWebDavUrl" />
                        <TextBlock Text="{x:Static resx:ResUI.LvWebDavUserName}" /><TextBox x:Name="txtWebDavUserName" />
                        <TextBlock Text="{x:Static resx:ResUI.LvWebDavPassword}" /><TextBox x:Name="txtWebDavPassword" PasswordChar="●" />
                        <TextBlock Text="{x:Static resx:ResUI.LvWebDavDirName}" /><TextBox x:Name="txtWebDavDirName" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="menuWebDavCheck" Content="{x:Static resx:ResUI.LvWebDavCheck}" Margin="0,0,12,8" />
                            <Button Name="menuRemoteBackup" Classes="primary" Content="{x:Static resx:ResUI.menuRemoteBackup}" Margin="0,0,12,8" />
                            <Button Name="menuRemoteRestore" Content="{x:Static resx:ResUI.menuRemoteRestore}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
