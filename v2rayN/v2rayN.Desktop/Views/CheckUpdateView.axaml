<UserControl x:Class="v2rayN.Desktop.Views.CheckUpdateView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
 xmlns:ws="clr-namespace:v2rayN.Desktop.Common" xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
 x:DataType="vms:CheckUpdateViewModel">
 <DockPanel>
  <Border Classes="surface" DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <WrapPanel>
    <TextBlock Text="{x:Static resx:ResUI.TbSettingsEnableUpdateViaProxy}" VerticalAlignment="Center" Margin="0,0,12,8"/>
    <ToggleSwitch x:Name="togEnableUpdateViaProxy" Margin="0,0,24,8"/>
    <Button x:Name="btnCheckOnly" Content="{x:Static resx:ResUI.menuCheckOnly}" Margin="0,0,12,8"/>
    <Button x:Name="btnCheckUpdate" Classes="primary" Content="{x:Static resx:ResUI.menuCheckAndUpdate}" Margin="0,0,0,8"/>
   </WrapPanel>
  </Border>
  <DataGrid x:Name="lstCheckUpdates" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
    BorderThickness="1" BorderBrush="{DynamicResource WorkspaceBorder}" ItemsSource="{Binding CheckUpdateModels}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="{x:Static ws:WorkspaceText.Component}" Binding="{Binding CoreTypeForStorage}" Width="*" MinWidth="120"/>
    <DataGridTemplateColumn Header="{x:Static ws:WorkspaceText.CurrentVersion}" Width="*" MinWidth="120"/>
    <DataGridTextColumn Header="{x:Static ws:WorkspaceText.UpdateState}" Binding="{Binding Remarks}" Width="2*" MinWidth="160"/>
    <DataGridTemplateColumn Header="Pre-Release" Width="160">
     <DataGridTemplateColumn.CellTemplate><DataTemplate><ToggleSwitch IsChecked="{Binding IsCheckPreRelease}" IsVisible="{Binding ShowCheckPreRelease}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>
