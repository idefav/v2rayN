<UserControl x:Class="v2rayN.Desktop.Views.SubSettingWindow"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ws="clr-namespace:v2rayN.Desktop.Common"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:entities="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    Tag="{x:Static ws:WorkspaceText.GroupsAndSubscriptions}" x:DataType="vms:SubSettingViewModel">
    <UserControl.Resources><conv:UnknownTextConverter x:Key="UnknownTextConverter" /></UserControl.Resources>
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True" Identifier="dialogHostSub">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
                <TextBlock x:Name="txtGroupHint" Classes="muted" TextWrapping="Wrap" />
                <WrapPanel x:Name="subscriptionToolbar">
                    <TextBox x:Name="txtSubscriptionFilter" Width="240" Margin="0,0,8,4" />
                    <ComboBox x:Name="cmbSubscriptionKind" Width="160" Margin="0,0,8,4" />
                    <Button x:Name="btnUpdateAll" Margin="0,0,4,4" />
                    <Button x:Name="btnUpdateOptions" Content="⌄" Margin="0,0,8,4">
                        <Button.Flyout><MenuFlyout><MenuItem x:Name="menuUpdateAllViaProxy" /></MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="menuSubAdd" Classes="primary" Content="{x:Static resx:ResUI.menuSubAdd}" Margin="0,0,8,4">
                        <Button.Flyout><MenuFlyout>
                            <MenuItem x:Name="menuAddSubscription" />
                            <MenuItem x:Name="menuAddLocalGroup" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="menuClose" Content="{x:Static resx:ResUI.menuClose}" IsVisible="False" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock x:Name="txtSubscriptionStatus" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
            <TextBlock x:Name="txtSubscriptionCount" DockPanel.Dock="Bottom" Classes="muted" Margin="8,12" />
            <DataGrid x:Name="lstSubscription" AutoGenerateColumns="False" BorderThickness="0"
                CanUserResizeColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                IsReadOnly="True" SelectionMode="Extended">
                <DataGrid.KeyBindings><KeyBinding Command="{Binding SubDeleteCmd}" Gesture="Delete" /></DataGrid.KeyBindings>
                <DataGrid.ContextMenu><ContextMenu>
                    <MenuItem x:Name="menuSubEdit2" Header="{x:Static resx:ResUI.menuSubEdit}" />
                    <MenuItem x:Name="menuUpdateSelected" />
                    <MenuItem x:Name="menuUpdateSelectedViaProxy" />
                    <MenuItem x:Name="menuSubShare2" Header="{x:Static resx:ResUI.menuSubShare}" />
                    <Separator />
                    <MenuItem x:Name="menuSubDelete2" Header="{x:Static resx:ResUI.menuSubDelete}" />
                </ContextMenu></DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn x:DataType="entities:SubItem" Width="180" MinWidth="120" Binding="{Binding Remarks, Mode=OneWay}" Header="{x:Static resx:ResUI.LvRemarks}" />
                    <DataGridTextColumn x:DataType="entities:SubItem" Width="*" MinWidth="180" Binding="{Binding Url, Mode=OneWay, Converter={StaticResource UnknownTextConverter}}" Header="{x:Static resx:ResUI.LvUrl}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </dialogHost:DialogHost>
</UserControl>
