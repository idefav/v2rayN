<Window x:Class="v2rayN.Desktop.Views.SshKeySetupWindow"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ws="clr-namespace:v2rayN.Desktop.Common"
    xmlns:services="clr-namespace:ServiceLib.Services;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:SshKeySetupViewModel" Title="{x:Static resx:SshStrings.SetupTitle}"
    Width="800" Height="840" MinWidth="600" MinHeight="480"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <TextBlock x:Name="txtStatus" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="{x:Static resx:SshStrings.SetupCancel}" MinWidth="90" Margin="4" />
                <Button x:Name="btnRun" Classes="primary" Content="{x:Static resx:SshStrings.SetupRun}" MinWidth="140" Margin="4" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <WrapPanel x:Name="setupStages" />
                <Border Classes="surface">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="txtTarget" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{x:Static resx:SshStrings.SetupNotice}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid x:Name="form" ColumnDefinitions="*" RowDefinitions="Auto,Auto">
                    <Border Classes="surface" Margin="0,0,8,0">
                        <StackPanel Spacing="12">
                            <RadioButton x:Name="radioReuse" GroupName="keyChoice" Content="{x:Static resx:SshStrings.ReuseKey}" />
                            <TextBlock x:Name="txtDiscovery" Classes="muted" TextWrapping="Wrap" />
                            <ListBox x:Name="listKeys" MaxHeight="200" MinHeight="120">
                                <ListBox.ItemTemplate><DataTemplate x:DataType="services:SshLocalKey">
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="8" />
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="btnBrowse" Content="{x:Static ws:WorkspaceText.SelectPrivateKey}" HorizontalAlignment="Left" />
                            <RadioButton x:Name="radioGenerate" GroupName="keyChoice" Content="{x:Static resx:SshStrings.GenerateKey}" Margin="0,8,0,0" />
                            <TextBlock Text="{x:Static resx:SshStrings.SetupPassphrase}" TextWrapping="Wrap" />
                            <TextBox x:Name="txtPassphrase" PasswordChar="●" />
                            <StackPanel x:Name="confirmationPanel" Spacing="6">
                                <TextBlock Text="{x:Static resx:SshStrings.ConfirmPassphrase}" /><TextBox x:Name="txtConfirmation" PasswordChar="●" />
                            </StackPanel>
                            <StackPanel x:Name="passwordPanel" Spacing="6">
                                <TextBlock Text="{x:Static resx:SshStrings.SetupPassword}" TextWrapping="Wrap" /><TextBox x:Name="txtPassword" PasswordChar="●" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="surface" Margin="0,12,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="sectionTitle" Text="{x:Static resx:SshStrings.ManualKey}" />
                            <TextBlock Classes="muted" Text="{x:Static resx:SshStrings.ManualHelp}" TextWrapping="Wrap" />
                            <TextBox x:Name="txtPublicKey" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="160" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
