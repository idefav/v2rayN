#!/bin/bash
# Keep failures in this shell; a pipeline/subshell or a final echo must not hide them.
set -u
ACTION=${1:-}
if [[ "$ACTION" != "set" && "$ACTION" != "clear" ]]; then
    echo "Usage: $0 set <IP> <port> [bypass ...] | clear" >&2
    exit 1
fi
if [[ "$ACTION" == "set" && $# -lt 3 ]]; then
    echo "Missing proxy address or port" >&2
    exit 1
fi
if ! SERVICES=$(networksetup -listallnetworkservices); then
    echo "Unable to list network services" >&2
    exit 1
fi
STATUS=0
COUNT=0
run() {
    if ! networksetup "$@"; then
        echo "System proxy operation failed: $1 for $2" >&2
        STATUS=1
    fi
}
if [[ "$ACTION" == "set" ]]; then
    PROXY_IP=$2
    PROXY_PORT=$3
    shift 3
    BYPASS=("$@")
    if [[ ${#BYPASS[@]} -eq 0 ]]; then BYPASS=("Empty"); fi
fi
while IFS= read -r SERVICE; do
    case "$SERVICE" in ""|\**) continue ;; esac
    COUNT=$((COUNT + 1))
    if [[ "$ACTION" == "set" ]]; then
        run -setwebproxy "$SERVICE" "$PROXY_IP" "$PROXY_PORT"
        run -setsecurewebproxy "$SERVICE" "$PROXY_IP" "$PROXY_PORT"
        run -setsocksfirewallproxy "$SERVICE" "$PROXY_IP" "$PROXY_PORT"
        run -setproxybypassdomains "$SERVICE" "${BYPASS[@]}"
    else
        run -setwebproxystate "$SERVICE" off
        run -setsecurewebproxystate "$SERVICE" off
        run -setsocksfirewallproxystate "$SERVICE" off
    fi
done < <(printf '%s\n' "$SERVICES" | tail -n +2)
if [[ $COUNT -eq 0 ]]; then
    echo "No enabled network services" >&2
    STATUS=1
fi
exit "$STATUS"
