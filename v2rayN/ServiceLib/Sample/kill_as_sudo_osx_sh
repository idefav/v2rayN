#!/bin/bash
# Portable macOS/Linux helper. Arguments are pairs: PID, immutable start time.
# Only identities supplied by the owner, and descendants found before signalling,
# are eligible for termination. All discovered identities are returned to the owner.
export LC_ALL=C
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
pids=()
births=()
row_pids=()
row_parents=()
row_births=()
row_states=()
row_commands=()

fail() { printf '%s\n' "$2" >&2; exit "$1"; }
snapshot() {
    local table pid parent weekday month day clock year state command
    table=$(ps -axo pid=,ppid=,lstart=,stat=,comm=) || fail 23 "Process enumeration failed"
    [ -n "$table" ] || fail 23 "Empty process enumeration"
    row_pids=(); row_parents=(); row_births=(); row_states=(); row_commands=()
    while read -r pid parent weekday month day clock year state command; do
        [[ "$pid" =~ ^[0-9]+$ && "$parent" =~ ^[0-9]+$ && -n "$command" ]] || fail 23 "Invalid process identity"
        row_pids+=("$pid"); row_parents+=("$parent")
        row_births+=("$weekday $month $day $clock $year")
        row_states+=("$state"); row_commands+=("$command")
    done <<< "$table"
}
locate() {
    found=-1
    local i
    for ((i=0; i<${#row_pids[@]}; i++)); do
        if [ "${row_pids[i]}" = "$1" ]; then found=$i; return; fi
    done
}
owned_index() {
    owned=-1
    local i
    for ((i=0; i<${#pids[@]}; i++)); do
        if [ "${pids[i]}" = "$1" ]; then owned=$i; return; fi
    done
}
validate() {
    local i
    alive=0
    for ((i=0; i<${#pids[@]}; i++)); do
        locate "${pids[i]}"
        [ "$found" -ge 0 ] || continue
        [ "${row_births[found]}" = "${births[i]}" ] || fail 20 "Identity changed: PID ${pids[i]}"
        [[ "${row_states[found]}" = Z* ]] || alive=$((alive + 1))
    done
}
expand() {
    local changed=1 i parent_index
    validate
    while [ "$changed" = 1 ]; do
        changed=0
        for ((i=0; i<${#row_pids[@]}; i++)); do
            owned_index "${row_parents[i]}"
            parent_index=$owned
            [ "$parent_index" -ge 0 ] || continue
            # A missing/reused parent is never a basis for discovering new children.
            locate "${pids[parent_index]}"
            [ "$found" -ge 0 ] || continue
            [ "${row_births[found]}" = "${births[parent_index]}" ] || fail 20 "Parent identity changed"
            owned_index "${row_pids[i]}"
            [ "$owned" -lt 0 ] || continue
            pids+=("${row_pids[i]}"); births+=("${row_births[i]}"); changed=1
        done
    done
    for ((i=0; i<${#pids[@]}; i++)); do
        locate "${pids[i]}"
        [ "$found" -ge 0 ] || continue
        printf 'IDENTITY\t%s\t%s\t%s\n' "${pids[i]}" "${births[i]}" "${row_commands[found]}"
    done
}
signal_owned() {
    local signal=$1 i target
    # Children first; keep the full snapshot even after parents have disappeared.
    for ((i=${#pids[@]}-1; i>=0; i--)); do
        snapshot
        locate "${pids[i]}"
        [ "$found" -ge 0 ] || continue
        [ "${row_births[found]}" = "${births[i]}" ] || fail 20 "Identity changed: PID ${pids[i]}"
        [[ "${row_states[found]}" = Z* ]] && continue
        target=${pids[i]}
        if ! kill "-$signal" "$target" 2>/dev/null; then
            snapshot
            locate "$target"
            if [ "$found" -ge 0 ] && [[ "${row_states[found]}" != Z* ]]; then
                fail 21 "Permission denied or signal failed: PID $target"
            fi
        fi
    done
}
wait_for_exit() {
    local deadline=$((SECONDS + $1))
    while [ "$SECONDS" -lt "$deadline" ]; do
        snapshot
        expand
        validate
        [ "$alive" = 0 ] && return 0
        sleep 0.1
    done
    return 1
}

[ "$#" -gt 0 ] && [ $(( $# % 2 )) = 0 ] || fail 23 "Expected PID/start-time pairs"
while [ "$#" -gt 0 ]; do
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -gt 1 ] && [ -n "$2" ] || fail 23 "Invalid process identity argument"
    pids+=("$1"); births+=("$2"); shift 2
done
snapshot
expand
printf 'STAGE\tSIGTERM\n'
signal_owned 15
wait_for_exit 5 && exit 0
snapshot
expand
printf 'STAGE\tSIGKILL\n'
signal_owned 9
wait_for_exit 3 && exit 0
fail 22 "Owned processes did not exit before the deadline"
