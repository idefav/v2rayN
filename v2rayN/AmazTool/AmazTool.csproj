<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
        <AssemblyName>AmazToolV2</AssemblyName>
        <RootNamespace>AmazTool</RootNamespace>
	</PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/ListenerBindProbe.cs" Link="ListenerBindProbe.cs" />
        <Compile Include="../Shared/AppUpgradeRequest.cs" Link="AppUpgradeRequest.cs" />
    </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resx\Resource.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resource.Designer.cs</LastGenOutput>
		</EmbeddedResource>

		<Compile Update="Resx\Resource.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resource.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
