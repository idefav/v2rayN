+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/protocol/ssh/udptunnel"
+	M "github.com/sagernet/sing/common/metadata"
+	"golang.org/x/crypto/ssh"
+)
+
+func nativeFixture(t *testing.T) (*Outbound, *ssh.Client) {
+	t.Helper()
+	path := os.Getenv("SSH_UDPGW_TEST_PROFILE")
+	if path == "" {
+		t.Skip("set SSH_UDPGW_TEST_PROFILE for disposable native OpenSSH tests")
+	}
+	var p struct {
+		DisposableFixture                 bool
+		Port                              int
+		Username, PrivateKeyPath, HostKey string
+	}
+	b, e := os.ReadFile(path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = json.Unmarshal(b, &p); e != nil || !p.DisposableFixture || p.Port < 1024 {
+		t.Fatal("disposable loopback fixture required", e)
+	}
+	b, e = os.ReadFile(p.PrivateKeyPath)
+	if e != nil {
+		t.Fatal(e)
+	}
+	signer, e := ssh.ParsePrivateKey(b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	key, _, _, _, e := ssh.ParseAuthorizedKey([]byte(p.HostKey))
+	if e != nil {
+		t.Fatal(e)
+	}
+	address := net.JoinHostPort("127.0.0.1", strconv.Itoa(p.Port))
+	c, e := ssh.Dial("tcp", address, &ssh.ClientConfig{User: p.Username, Auth: []ssh.AuthMethod{ssh.PublicKeys(signer)}, HostKeyAlgorithms: []string{key.Type()}, HostKeyCallback: ssh.FixedHostKey(key), Timeout: 5 * time.Second})
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { c.Close() })
+	out := &Outbound{udpForwarding: true, udpSlots: make(chan struct{}, 64), dialer: fixtureDialer{}, serverAddr: M.ParseSocksaddr(address), user: p.Username, authMethod: []ssh.AuthMethod{ssh.PublicKeys(signer)}, hostKey: []ssh.PublicKey{key}, hostKeyAlgorithms: []string{key.Type()}}
+	t.Cleanup(func() { out.closeUDPTransports(true) })
+	return out, c
+}
+
+func TestNativeSSHDatagramsAndGateway(t *testing.T) {
+	if os.Getenv("SSH_UDP_NATIVE_SLOW") != "" {
+		t.Skip("slow resolver scenario")
+	}
+	out, _ := nativeFixture(t)
+	for _, mode := range []string{"custom", "tun2proxy"} {
+		t.Run(mode, func(t *testing.T) {
+			out.udpMode = mode
+			out.udpGateway = "127.0.0.1:7300"
+			for _, target := range []string{"127.0.0.1:29001", "[::1]:29001", "localhost:29001"} {
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				c, e := out.dialUDP(ctx, M.ParseSocksaddr(target))
+				cancel()
+				if e != nil {
+					t.Fatal(target, e)
+				}
+				for _, payload := range [][]byte{nil, []byte("native-ssh-udp"), bytes.Repeat([]byte{0x6a}, 60000)} {
+					c.SetDeadline(time.Now().Add(3 * time.Second))
+					if _, e = c.Write(payload); e != nil {
+						t.Fatal(e)
+					}
+					buf := make([]byte, 65535)
+					n, e := c.Read(buf)
+					if e != nil || !bytes.Equal(buf[:n], payload) {
+						t.Fatalf("%s %s length %d: %v", mode, target, len(payload), e)
+					}
+				}
+				c.Close()
+			}
+		})
+	}
+}
+
+func TestNativeSSHPolicyAndACL(t *testing.T) {
+	want := os.Getenv("SSH_UDP_EXPECT_CUSTOM")
+	if want == "" {
+		t.Skip("set SSH_UDP_EXPECT_CUSTOM for native policy fixtures")
+	}
+	_, client := nativeFixture(t)
+	watchdog := time.AfterFunc(5*time.Second, func() { client.Close() })
+	defer watchdog.Stop()
+	accepted, payload, err := client.SendRequest(udptunnel.CapabilityRequest, true, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want == "unsupported" {
+		if accepted {
+			t.Fatal("stock server accepted private protocol")
+		}
+	} else {
+		n, err := strconv.Atoi(want)
+		if err != nil || !accepted || len(payload) != 1 || int(payload[0]) != n {
+			t.Fatalf("capability: %v %v", accepted, payload)
+		}
+	}
+	c, err := client.Dial("tcp", "127.0.0.1:7300")
+	allow := os.Getenv("SSH_UDP_EXPECT_GATEWAY") == "ready"
+	if !allow {
+		if err == nil {
+			c.Close()
+			t.Fatal("TCP ACL/bypass unexpectedly allowed gateway")
+		}
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	heartbeat := []byte{0, 3, 1, 0, 1}
+	if _, err = c.Write(heartbeat); err != nil {
+		t.Fatal(err)
+	}
+	response := make([]byte, len(heartbeat))
+	if _, err = io.ReadFull(c, response); err != nil || !bytes.Equal(response, heartbeat) {
+		t.Fatal("gateway heartbeat", err)
+	}
+}
+
+func TestNativeSlowDNSDoesNotBlockTCPOrLeakResolvers(t *testing.T) {
+	slow := os.Getenv("SSH_UDP_NATIVE_SLOW")
+	if slow == "" {
+		t.Skip("set SSH_UDP_NATIVE_SLOW=direct/proxy/relay with the slow resolver fixture")
+	}
+	_, client := nativeFixture(t)
+	tcp, e := client.Dial("tcp", "127.0.0.1:29001")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer tcp.Close()
+	target := "127.0.0.1:29001"
+	if slow == "direct" {
+		target = "slow.test:29001"
+	}
+	start := time.Now()
+	results := make(chan error, 8)
+	for i := 0; i < cap(results); i++ {
+		go func() {
+			_, _, e := client.OpenChannel(udptunnel.ChannelType, ssh.Marshal(struct {
+				Host string
+				Port uint32
+			}{M.ParseSocksaddr(target).AddrString(), 29001}))
+			results <- e
+		}()
+	}
+	for i := 0; i < 15; i++ {
+		operation := time.Now()
+		tcp.SetDeadline(time.Now().Add(500 * time.Millisecond))
+		if _, e = tcp.Write([]byte("ok")); e != nil {
+			t.Fatal("existing TCP blocked", e)
+		}
+		var b [2]byte
+		if _, e = io.ReadFull(tcp, b[:]); e != nil || string(b[:]) != "ok" {
+			t.Fatal("existing TCP interrupted", e)
+		}
+		if time.Since(operation) > 500*time.Millisecond {
+			t.Fatal("TCP stalled behind DNS")
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	for i := 0; i < cap(results); i++ {
+		select {
+		case e := <-results:
+			if e == nil {
+				t.Fatal("slow DNS unexpectedly connected")
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("resolver exceeded setup deadline")
+		}
+	}
+	if elapsed := time.Since(start); elapsed < 1800*time.Millisecond || elapsed > 5*time.Second {
+		t.Fatalf("resolver deadline not applied: %v", elapsed)
+	}
+	// A fresh connection after failures verifies server recovery independently
+	// of the already-established control channel.
+	tcp.SetDeadline(time.Now().Add(time.Second))
+	tcp.Write([]byte("ok"))
+	var b [2]byte
+	if _, e = io.ReadFull(tcp, b[:]); e != nil {
+		t.Fatal(e)
+	}
+}
diff --git a/protocol/ssh/udp_packet.go b/protocol/ssh/udp_packet.go
new file mode 100644
index 0000000..3e2c160
--- /dev/null
+++ b/protocol/ssh/udp_packet.go
@@ -0,0 +1,291 @@
+package ssh
+
+import (
+	"context"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/protocol/ssh/udptunnel"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/pipe"
+)
+
+type udpReply struct {
+	data []byte
+	from M.Socksaddr
+}
+type udpPending struct {
+	done     chan struct{}
+	conn     net.Conn
+	err      error
+	cancel   context.CancelFunc
+	timer    *time.Timer
+	timedOut bool
+}
+
+// TUN endpoint-independent mappings may send several destinations through one
+// PacketConn. Keep a distinct wire association per destination and merge replies
+// with their original destination, including remotely resolved domain names.
+type udpPacketConn struct {
+	ctx         context.Context
+	cancel      context.CancelFunc
+	out         *Outbound
+	destination M.Socksaddr
+	mu          sync.Mutex
+	conns       map[M.Socksaddr]net.Conn
+	opening     map[M.Socksaddr]*udpPending
+	packets     chan udpReply
+	done        chan struct{}
+	once        sync.Once
+	err         error
+	rd          pipe.Deadline
+	wd          time.Time
+	idle        *time.Timer
+}
+
+var _ N.NetPacketConn = (*udpPacketConn)(nil)
+
+func (s *Outbound) listenUDPPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	c := &udpPacketConn{ctx: ctx, cancel: cancel, out: s, destination: destination.Unwrap(),
+		conns: make(map[M.Socksaddr]net.Conn), opening: make(map[M.Socksaddr]*udpPending),
+		packets: make(chan udpReply, 16), done: make(chan struct{}), rd: pipe.MakeDeadline()}
+	c.idle = time.AfterFunc(udptunnel.IdleTimeout, func() { c.Close() })
+	if _, err := c.connection(destination.Unwrap()); err != nil {
+		c.Close()
+		return nil, err
+	}
+	return c, nil
+}
+
+func (c *udpPacketConn) connection(target M.Socksaddr) (net.Conn, error) {
+	c.mu.Lock()
+	select {
+	case <-c.done:
+		c.mu.Unlock()
+		return nil, net.ErrClosed
+	default:
+	}
+	if conn := c.conns[target]; conn != nil {
+		c.mu.Unlock()
+		return conn, nil
+	}
+	if pending := c.opening[target]; pending != nil {
+		c.mu.Unlock()
+		select {
+		case <-pending.done:
+			return pending.conn, pending.err
+		case <-c.done:
+			return nil, net.ErrClosed
+		}
+	}
+	ctx, cancel := context.WithCancel(c.ctx)
+	pending := &udpPending{done: make(chan struct{}), cancel: cancel}
+	c.opening[target] = pending
+	c.setPendingDeadline(pending)
+	c.mu.Unlock()
+	conn, err := c.out.dialUDP(ctx, target)
+	cancel()
+	c.mu.Lock()
+	if pending.timer != nil {
+		pending.timer.Stop()
+	}
+	if pending.timedOut {
+		if conn != nil {
+			conn.Close()
+		}
+		conn, err = nil, os.ErrDeadlineExceeded
+	}
+	select {
+	case <-c.done:
+		if conn != nil {
+			conn.Close()
+		}
+		conn = nil
+		err = net.ErrClosed
+	default:
+	}
+	if err == nil {
+		conn.SetWriteDeadline(c.wd)
+		c.conns[target] = conn
+		go c.readLoop(target, conn)
+	}
+	pending.conn, pending.err = conn, err
+	delete(c.opening, target)
+	close(pending.done)
+	c.mu.Unlock()
+	return conn, err
+}
+
+// Called with mu held. Recheck the current deadline in the callback because an
+// earlier timer may already be firing when SetWriteDeadline extends or clears it.
+func (c *udpPacketConn) setPendingDeadline(pending *udpPending) {
+	if pending.timer != nil {
+		pending.timer.Stop()
+	}
+	if c.wd.IsZero() {
+		return
+	}
+	pending.timer = time.AfterFunc(time.Until(c.wd), func() {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		select {
+		case <-pending.done:
+			return
+		default:
+		}
+		if !c.wd.IsZero() && !time.Now().Before(c.wd) {
+			pending.timedOut = true
+			pending.cancel()
+		}
+	})
+}
+
+func (c *udpPacketConn) readLoop(target M.Socksaddr, conn net.Conn) {
+	var readErr error
+	defer func() {
+		conn.Close()
+		c.mu.Lock()
+		if c.conns[target] == conn {
+			delete(c.conns, target)
+		}
+		c.mu.Unlock()
+		if readErr != nil {
+			c.fail(readErr, true)
+		}
+	}()
+	for {
+		packet := make([]byte, udptunnel.MaxPayload)
+		n, err := conn.Read(packet)
+		if err != nil {
+			readErr = err
+			return
+		}
+		c.touch()
+		select {
+		case <-c.done:
+			return
+		default:
+		}
+		select {
+		case c.packets <- udpReply{data: packet[:n], from: target}:
+		default:
+		}
+	}
+}
+
+func (c *udpPacketConn) touch() {
+	c.mu.Lock()
+	select {
+	case <-c.done:
+	default:
+		c.idle.Reset(udptunnel.IdleTimeout)
+	}
+	c.mu.Unlock()
+}
+
+func (c *udpPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	select {
+	case <-c.done:
+		return 0, nil, c.closedError()
+	case <-c.rd.Wait():
+		return 0, nil, os.ErrDeadlineExceeded
+	default:
+	}
+	select {
+	case <-c.done:
+		return 0, nil, c.closedError()
+	case <-c.rd.Wait():
+		return 0, nil, os.ErrDeadlineExceeded
+	case packet := <-c.packets:
+		n := copy(p, packet.data)
+		if n < len(packet.data) {
+			return n, packet.from, io.ErrShortBuffer
+		}
+		return n, packet.from, nil
+	}
+}
+
+func (c *udpPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	if len(p) > udptunnel.MaxPayload {
+		return 0, udptunnel.ErrTooLarge
+	}
+	target := c.destination
+	if addr != nil {
+		target = M.SocksaddrFromNet(addr).Unwrap()
+	}
+	conn, err := c.connection(target)
+	if err != nil {
+		return 0, err
+	}
+	n, err := conn.Write(p)
+	if err == nil {
+		c.touch()
+	}
+	return n, err
+}
+
+func (c *udpPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	n, from, err := c.ReadFrom(buffer.FreeBytes())
+	buffer.Truncate(n)
+	if from == nil {
+		return M.Socksaddr{}, err
+	}
+	return M.SocksaddrFromNet(from), err
+}
+
+func (c *udpPacketConn) WritePacket(buffer *buf.Buffer, target M.Socksaddr) error {
+	defer buffer.Release()
+	_, err := c.WriteTo(buffer.Bytes(), target)
+	return err
+}
+
+func (c *udpPacketConn) fail(err error, onlyIfEmpty bool) {
+	c.mu.Lock()
+	if onlyIfEmpty && (len(c.conns) != 0 || len(c.opening) != 0) {
+		c.mu.Unlock()
+		return
+	}
+	var all []net.Conn
+	c.once.Do(func() {
+		c.cancel()
+		c.err = err
+		close(c.done)
+		c.idle.Stop()
+		all = make([]net.Conn, 0, len(c.conns))
+		for _, conn := range c.conns {
+			all = append(all, conn)
+		}
+		c.conns = make(map[M.Socksaddr]net.Conn)
+	})
+	c.mu.Unlock()
+	for _, conn := range all {
+		conn.Close()
+	}
+}
+
+func (c *udpPacketConn) closedError() error  { c.mu.Lock(); defer c.mu.Unlock(); return c.err }
+func (c *udpPacketConn) Close() error        { c.fail(net.ErrClosed, false); return nil }
+func (c *udpPacketConn) LocalAddr() net.Addr { return &net.UDPAddr{} }
+func (c *udpPacketConn) SetDeadline(t time.Time) error {
+	c.SetReadDeadline(t)
+	return c.SetWriteDeadline(t)
+}
+func (c *udpPacketConn) SetReadDeadline(t time.Time) error { c.rd.Set(t); return nil }
+func (c *udpPacketConn) SetWriteDeadline(t time.Time) error {
+	c.mu.Lock()
+	c.wd = t
+	for _, pending := range c.opening {
+		c.setPendingDeadline(pending)
+	}
+	for _, conn := range c.conns {
+		conn.SetWriteDeadline(t)
+	}
+	c.mu.Unlock()
+	return nil
+}
