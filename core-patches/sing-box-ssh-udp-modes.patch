+package ssh
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type blockedSetupDialer struct{ active, maximum, total atomic.Int32 }
+
+func (d *blockedSetupDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("unused")
+}
+
+func (d *blockedSetupDialer) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	n := d.active.Add(1)
+	d.total.Add(1)
+	defer d.active.Add(-1)
+	for old := d.maximum.Load(); n > old && !d.maximum.CompareAndSwap(old, n); old = d.maximum.Load() {
+	}
+	<-ctx.Done()
+	return nil, ctx.Err()
+}
+
+func TestUDPSetupQueueBoundAndCancellation(t *testing.T) {
+	d := &blockedSetupDialer{}
+	out := &Outbound{udpForwarding: true, udpSlots: make(chan struct{}, 64), dialer: d}
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 12)
+	for i := 0; i < cap(done); i++ {
+		go func() { _, err := out.dialUDP(ctx, M.ParseSocksaddr("127.0.0.1:53")); done <- err }()
+	}
+	for i := 0; i < cap(done); i++ {
+		if err := <-done; !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("queue cancellation: %v", err)
+		}
+	}
+	if d.maximum.Load() != 4 {
+		t.Fatalf("concurrent setups = %d", d.maximum.Load())
+	}
+	if d.total.Load() > 4 {
+		t.Fatalf("cancelled queued work started a connection: %d", d.total.Load())
+	}
+	if len(out.udpSlots) != 0 || len(out.udpTransports) != 0 {
+		t.Fatal("cancelled work retained slots")
+	}
+}
diff --git a/protocol/ssh/udpgw/conn.go b/protocol/ssh/udpgw/conn.go
new file mode 100644
index 0000000..d2ec18a
--- /dev/null
+++ b/protocol/ssh/udpgw/conn.go
@@ -0,0 +1,151 @@
+// Package udpgw implements tun2proxy's UDP Gateway protocol, not SagerNet UoT
+// or BadVPN. Wire reference: tun2proxy/tun2proxy src/udpgw.rs.
+package udpgw
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net/netip"
+
+	"github.com/sagernet/sing-box/protocol/ssh/udptunnel"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+const (
+	Keepalive    byte   = 1
+	Data         byte   = 2
+	Close        byte   = 4
+	RemoteError  byte   = 32
+	connectionID uint16 = 1 // One destination per isolated gateway TCP stream.
+)
+
+var ErrProtocol = errors.New("E_UDPGW_PROTOCOL")
+var ErrRemote = errors.New("E_UDPGW_REMOTE")
+
+func addressBytes(target M.Socksaddr) ([]byte, error) {
+	target = target.Unwrap()
+	if !target.IsValid() || target.Port == 0 {
+		return nil, ErrProtocol
+	}
+	var address []byte
+	if target.Addr.Is4() {
+		address = append([]byte{1}, target.Addr.AsSlice()...)
+	} else if target.Addr.Is6() {
+		address = append([]byte{4}, target.Addr.AsSlice()...)
+	} else {
+		if len(target.Fqdn) == 0 || len(target.Fqdn) > 255 {
+			return nil, ErrProtocol
+		}
+		address = append([]byte{3, byte(len(target.Fqdn))}, []byte(target.Fqdn)...)
+	}
+	return binary.BigEndian.AppendUint16(address, target.Port), nil
+}
+
+func parseAddress(data []byte) (M.Socksaddr, []byte, error) {
+	var addr M.Socksaddr
+	if len(data) < 1 {
+		return addr, nil, ErrProtocol
+	}
+	addressType := data[0]
+	n := 0
+	switch addressType {
+	case 1:
+		n = 4
+	case 4:
+		n = 16
+	case 3:
+		if len(data) < 2 || data[1] == 0 {
+			return addr, nil, ErrProtocol
+		}
+		n = int(data[1])
+		data = data[1:]
+	default:
+		return addr, nil, ErrProtocol
+	}
+	if len(data) < 1+n+2 {
+		return addr, nil, ErrProtocol
+	}
+	if addressType == 1 || addressType == 4 {
+		addr.Addr, _ = netip.AddrFromSlice(data[1 : 1+n])
+	} else {
+		addr.Fqdn = string(data[1 : 1+n])
+	}
+	addr.Port = binary.BigEndian.Uint16(data[1+n:])
+	return addr.Unwrap(), data[1+n+2:], nil
+}
+
+func NewConn(stream io.ReadWriteCloser, abort func(), target M.Socksaddr) (*udptunnel.Conn, error) {
+	address, err := addressBytes(target)
+	if err != nil {
+		stream.Close()
+		return nil, err
+	}
+	target = target.Unwrap()
+	read := func(r io.Reader) ([]byte, error) {
+		for {
+			var length [2]byte
+			if _, err := io.ReadFull(r, length[:]); err != nil {
+				return nil, err
+			}
+			n := int(binary.BigEndian.Uint16(length[:]))
+			if n < 3 {
+				return nil, ErrProtocol
+			}
+			frame := make([]byte, n)
+			if _, err := io.ReadFull(r, frame); err != nil {
+				return nil, err
+			}
+			if binary.BigEndian.Uint16(frame[1:3]) != connectionID {
+				return nil, ErrProtocol
+			}
+			switch frame[0] {
+			case Keepalive:
+				if n != 3 {
+					return nil, ErrProtocol
+				}
+				continue
+			case Close, RemoteError:
+				if n != 3 {
+					return nil, ErrProtocol
+				}
+				return nil, ErrRemote
+			case Data:
+				from, payload, err := parseAddress(frame[3:])
+				if err != nil || from.Port != target.Port || (target.IsIP() && from != target) {
+					return nil, ErrProtocol
+				}
+				if len(payload) > udptunnel.MaxPayload {
+					return nil, udptunnel.ErrTooLarge
+				}
+				return payload, nil
+			default:
+				return nil, ErrProtocol
+			}
+		}
+	}
+	write := func(w io.Writer, payload []byte) error {
+		n := 3 + len(address) + len(payload)
+		if n > 65535 || len(payload) > udptunnel.MaxPayload {
+			return udptunnel.ErrTooLarge
+		}
+		frame := make([]byte, 5, 2+n)
+		binary.BigEndian.PutUint16(frame, uint16(n))
+		frame[2] = Data
+		binary.BigEndian.PutUint16(frame[3:], connectionID)
+		frame = append(frame, address...)
+		frame = append(frame, payload...)
+		for len(frame) > 0 {
+			n, err := w.Write(frame)
+			if err != nil {
+				return err
+			}
+			if n <= 0 || n > len(frame) {
+				return io.ErrShortWrite
+			}
+			frame = frame[n:]
+		}
+		return nil
+	}
+	return udptunnel.NewConnWithFraming(stream, abort, target.String(), read, write), nil
+}
