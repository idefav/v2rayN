+func sshUDPOptions(options option.SSHOutboundOptions) (string, string, error) {
+	mode := options.UDPMode
+	if mode == "" {
+		mode = "disabled"
+		if options.UDPForwarding {
+			mode = "custom"
+		}
+	}
+	if mode != "disabled" && mode != "custom" && mode != "tun2proxy" {
+		return "", "", errors.New("invalid SSH udp_mode: expected disabled, custom or tun2proxy")
+	}
+	if mode != "tun2proxy" {
+		if options.UDPGateway != "" {
+			return "", "", errors.New("udp_gateway requires udp_mode tun2proxy")
+		}
+		return mode, "", nil
+	}
+	gateway := options.UDPGateway
+	if gateway == "" {
+		gateway = "127.0.0.1:7300"
+	}
+	host, port, err := net.SplitHostPort(gateway)
+	n, portErr := strconv.Atoi(port)
+	if err != nil || portErr != nil || n < 1 || n > 65535 || host == "" || len(host) > 255 || strings.ContainsAny(host, "\x00\r\n\t /?#@") {
+		return "", "", errors.New("invalid SSH udp_gateway: expected host:port or [IPv6]:port")
+	}
+	return mode, net.JoinHostPort(host, strconv.Itoa(n)), nil
+}
