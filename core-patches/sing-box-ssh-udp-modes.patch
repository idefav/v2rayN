+
+func TestGoldenWireAndFragmentedReply(t *testing.T) {
+	a, b := net.Pipe()
+	defer b.Close()
+	conn, err := NewConn(a, func() { a.Close() }, M.ParseSocksaddr("1.2.3.4:53"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(time.Second))
+	want := []byte{0, 11, 2, 0, 1, 1, 1, 2, 3, 4, 0, 53, 'A'}
+	result := make(chan error, 1)
+	go func() { _, err := conn.Write([]byte("A")); result <- err }()
+	wire := make([]byte, len(want))
+	if _, err = io.ReadFull(b, wire); err != nil || !bytes.Equal(wire, want) {
+		t.Fatal(wire, err)
+	}
+	if err = <-result; err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		b.Write([]byte{0, 3, 1, 0, 1}) // KEEPALIVE is not an empty datagram.
+		for _, value := range want {
+			b.Write([]byte{value})
+		}
+	}()
+	p := make([]byte, 8)
+	n, err := conn.Read(p)
+	if err != nil || string(p[:n]) != "A" {
+		t.Fatal(n, err)
+	}
+}
+
+func TestRejectMalformedOrRemoteErrorFrames(t *testing.T) {
+	for _, tc := range []struct {
+		wire []byte
+		want error
+	}{
+		{[]byte{0, 2, 2, 0}, ErrProtocol},
+		{[]byte{0, 3, 32, 0, 1}, ErrRemote},
+		{[]byte{0, 3, 4, 0, 1}, ErrRemote},
+		{[]byte{0, 3, 2, 0, 2}, ErrProtocol},
+		{[]byte{0, 3, 128, 0, 1}, ErrProtocol},
+		{[]byte{0, 6, 2, 0, 1, 3, 5, 'a'}, ErrProtocol},
+		{[]byte{0, 10, 2, 0, 1, 1, 1, 2, 3, 5, 0, 53}, ErrProtocol},
+	} {
+		a, b := net.Pipe()
+		conn, err := NewConn(a, func() { a.Close() }, M.ParseSocksaddr("1.2.3.4:53"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		conn.SetReadDeadline(time.Now().Add(time.Second))
+		go func() { b.Write(tc.wire); b.Close() }()
+		_, err = conn.Read(make([]byte, 100))
+		conn.Close()
+		if !errors.Is(err, tc.want) {
+			t.Fatal(tc.wire, err)
+		}
+	}
+}
+
+func TestAddressRoundTrip(t *testing.T) {
+	for _, value := range []string{"1.2.3.4:53", "[2001:db8::1]:65535", "a:1", "host:2", "remote.example:1234"} {
+		target := M.ParseSocksaddr(value)
+		wire, err := addressBytes(target)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, payload, err := parseAddress(append(wire, 'x'))
+		if err != nil || got != target || string(payload) != "x" {
+			t.Fatal(value, got, err)
+		}
+	}
+}
