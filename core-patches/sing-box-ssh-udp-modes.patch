+// Each UDP destination owns its SSH transport. Stuck DNS, channel setup, and
+// cleanup cannot retire the shared TCP transport or another UDP destination.
+// The outbound-wide semaphore bounds both live and pending transports.
+type udpTransport struct {
+	parent *Outbound
+	owner  *Outbound
+	cancel context.CancelFunc
+	once   sync.Once
+}
+
+func (t *udpTransport) Close() {
+	t.once.Do(func() {
+		t.cancel()
+		t.owner.clientAccess.Lock()
+		client, raw := t.owner.client, t.owner.clientConn
+		t.owner.clientAccess.Unlock()
+		if raw != nil {
+			raw.Close()
+		}
+		if client != nil {
+			client.Close()
+		}
+		t.parent.udpAccess.Lock()
+		delete(t.parent.udpTransports, t)
+		t.parent.udpAccess.Unlock()
+		<-t.parent.udpSlots
+	})
+}
+
+func (s *Outbound) closeUDPTransports(permanent bool) {
+	s.udpAccess.Lock()
+	if permanent {
+		s.udpClosed = true
+	}
+	all := make([]*udpTransport, 0, len(s.udpTransports))
+	for transport := range s.udpTransports {
+		all = append(all, transport)
+	}
+	s.udpAccess.Unlock()
+	for _, transport := range all {
+		transport.Close()
+	}
+}
