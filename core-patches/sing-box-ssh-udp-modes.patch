+
+func TestSSHUDPModeValidation(t *testing.T) {
+	for _, tc := range []struct {
+		options       option.SSHOutboundOptions
+		mode, gateway string
+		bad           bool
+	}{
+		{options: option.SSHOutboundOptions{}, mode: "disabled"},
+		{options: option.SSHOutboundOptions{UDPForwarding: true}, mode: "custom"},
+		{options: option.SSHOutboundOptions{UDPMode: "custom"}, mode: "custom"},
+		{options: option.SSHOutboundOptions{UDPMode: "tun2proxy"}, mode: "tun2proxy", gateway: "127.0.0.1:7300"},
+		{options: option.SSHOutboundOptions{UDPMode: "tun2proxy", UDPGateway: "[::1]:7300"}, mode: "tun2proxy", gateway: "[::1]:7300"},
+		{options: option.SSHOutboundOptions{UDPMode: "disabled", UDPForwarding: true}, mode: "disabled"},
+		{options: option.SSHOutboundOptions{UDPMode: "badvpn"}, bad: true},
+		{options: option.SSHOutboundOptions{UDPGateway: "localhost:7300"}, bad: true},
+		{options: option.SSHOutboundOptions{UDPMode: "tun2proxy", UDPGateway: "host:0"}, bad: true},
+		{options: option.SSHOutboundOptions{UDPMode: "tun2proxy", UDPGateway: "http://host:7300"}, bad: true},
+	} {
+		mode, gateway, err := sshUDPOptions(tc.options)
+		if (err != nil) != tc.bad || (!tc.bad && (mode != tc.mode || gateway != tc.gateway)) {
+			t.Fatal(tc, mode, gateway, err)
+		}
+	}
+}
+
+func TestTun2ProxyOverStandardSSH(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go func() {
+		for {
+			stream, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer stream.Close()
+				for {
+					var length [2]byte
+					if _, err := io.ReadFull(stream, length[:]); err != nil {
+						return
+					}
+					n := int(binary.BigEndian.Uint16(length[:]))
+					if n < 3 {
+						return
+					}
+					body := make([]byte, n)
+					if _, err := io.ReadFull(stream, body); err != nil {
+						return
+					}
+					if body[0] != 2 || body[1] != 0 || body[2] != 1 {
+						return
+					}
+					// An independent wire fixture echoes a framed datagram with
+					// deliberate fragmentation, without using the client codec.
+					for _, chunk := range [][]byte{length[:1], length[1:], body[:3], body[3:]} {
+						if _, err := stream.Write(chunk); err != nil {
+							return
+						}
+					}
+				}
+			}()
+		}
+	}()
+	out, _ := udpFixtureWithGateway(t, -1, listener.Addr().String())
+	out.udpMode, out.udpGateway = "tun2proxy", listener.Addr().String()
+	conn, err := out.ListenPacket(context.Background(), M.ParseSocksaddr("203.0.113.10:3478"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for _, target := range []string{"203.0.113.10:3478", "203.0.113.10:3479", "[2001:db8::1]:53", "remote.example:53"} {
+		for _, data := range [][]byte{nil, []byte("hello"), bytes.Repeat([]byte{7}, 32769)} {
+			conn.SetDeadline(time.Now().Add(3 * time.Second))
+			if _, err := conn.WriteTo(data, M.ParseSocksaddr(target)); err != nil {
+				t.Fatal(target, err)
+			}
+			buffer := make([]byte, 65535)
+			n, from, err := conn.ReadFrom(buffer)
+			if err != nil || !bytes.Equal(buffer[:n], data) || from.String() != target {
+				t.Fatal(target, n, from, err)
+			}
+		}
+	}
+}
+
+// Run with UDPGW_TEST_ADDRESS pointed at the official tun2proxy udpgw-server
+// on loopback. Both SSH and the destination UDP server stay local.
+func TestTun2ProxyOfficialGateway(t *testing.T) {
+	gateway := os.Getenv("UDPGW_TEST_ADDRESS")
+	if gateway == "" {
+		t.Skip("set UDPGW_TEST_ADDRESS for official gateway interoperability")
+	}
+	gw := M.ParseSocksaddr(gateway)
+	if !gw.Addr.IsLoopback() {
+		t.Fatal("integration gateway must be on loopback")
+	}
+	out, _ := udpFixtureWithGateway(t, -1, gateway)
+	out.udpMode, out.udpGateway = "tun2proxy", gateway
+	var endpoints []net.PacketConn
+	for i := 0; i < 2; i++ {
+		echo, err := net.ListenPacket("udp4", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer echo.Close()
+		endpoints = append(endpoints, echo)
+		go func() {
+			b := make([]byte, 65535)
+			for {
+				n, from, err := echo.ReadFrom(b)
+				if err != nil {
+					return
+				}
+				echo.WriteTo(b[:n], from)
+			}
+		}()
+	}
+	conn, err := out.ListenPacket(context.Background(), M.ParseSocksaddr(endpoints[0].LocalAddr().String()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for _, echo := range endpoints {
+		target := M.ParseSocksaddr(echo.LocalAddr().String())
+		for _, data := range [][]byte{nil, []byte("official-gateway"), bytes.Repeat([]byte{0x51}, 1200)} {
+			conn.SetDeadline(time.Now().Add(3 * time.Second))
+			if _, err := conn.WriteTo(data, target); err != nil {
+				t.Fatal(err)
+			}
+			b := make([]byte, 65535)
+			n, from, err := conn.ReadFrom(b)
+			if err != nil || !bytes.Equal(b[:n], data) || from.String() != target.String() {
+				t.Fatal(n, from, err)
+			}
+		}
+	}
+}
