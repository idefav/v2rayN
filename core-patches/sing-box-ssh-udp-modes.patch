+package ssh
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/route"
+	tun "github.com/sagernet/sing-tun"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type natSSHHandler struct {
+	out     *Outbound
+	manager *route.ConnectionManager
+	closed  chan error
+}
+
+func (h *natSSHHandler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h.manager.NewPacketConnection(ctx, h.out, conn, adapter.InboundContext{InboundType: "tun", Network: N.NetworkUDP, Source: source, Destination: destination}, func(err error) {
+		if onClose != nil {
+			onClose(err)
+		}
+		h.closed <- err
+	})
+}
+
+type natSSHWriter struct{ replies chan string }
+
+func (w *natSSHWriter) WritePacket(buffer *buf.Buffer, _ M.Socksaddr) error {
+	defer buffer.Release()
+	w.replies <- string(buffer.Bytes())
+	return nil
+}
+
+func TestTUNMappingMultipleDestinations(t *testing.T) {
+	for _, mapping := range []tun.NATMapping{tun.NATMappingEndpointIndependent, tun.NATMappingAddressDependent, tun.NATMappingAddressAndPortDependent} {
+		out, _ := udpFixture(t, 0)
+		handler := &natSSHHandler{out: out, manager: route.NewConnectionManager(logger.NOP()), closed: make(chan error, 8)}
+		writer := &natSSHWriter{replies: make(chan string, 8)}
+		nat := tun.NewUDPNat(tun.UDPNatOptions{Handler: handler, Timeout: time.Minute, Shared: true, MaxSize: 16, Mapping: mapping,
+			Prepare: func(_, _ M.Socksaddr, _ any) (bool, context.Context, N.PacketWriter, N.CloseHandlerFunc) {
+				return true, context.Background(), writer, nil
+			},
+		})
+		if err := nat.Start(); err != nil {
+			t.Fatal(err)
+		}
+		for _, target := range []string{"203.0.113.1:3478", "203.0.113.1:3479", "203.0.113.2:3478", "203.0.113.1:3478"} {
+			nat.NewPacket([][]byte{[]byte(target)}, M.ParseSocksaddr("10.0.0.2:40000"), M.ParseSocksaddr(target), nil)
+			select {
+			case reply := <-writer.replies:
+				if reply != target {
+					t.Fatal(reply, target)
+				}
+			case err := <-handler.closed:
+				t.Fatal("NAT association closed", mapping, err)
+			case <-time.After(3 * time.Second):
+				t.Fatal("UDP echo timed out", mapping, target)
+			}
+		}
+		nat.Close()
+	}
+}
